# Optional: register this project's DEVELOPMENT client using @freebuff/auth.
# Anonymous play and the public leaderboard work without these values.
# Never put a production client ID in a loopback development environment.
# FREEBUFF_CLIENT_ID=<registered development client ID>
# FREEBUFF_ISSUER=https://freebuff.com/oidc
# APP_ORIGIN=http://127.0.0.1:5188
